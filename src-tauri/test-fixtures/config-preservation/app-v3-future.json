    "executionProfile": "future-signed-profile"
  },
  "scripts": {
    "invoiceWorkflowScript": "D:\\FutureFixture\\Scripts\\invoice.py",
    "gmailDraftScript": "D:\\FutureFixture\\Scripts\\gmail.py",
    "copyScansioniScript": "D:\\FutureFixture\\Scripts\\copy.py",
    "ocrPreprocessingScript": "D:\\FutureFixture\\Scripts\\ocr.py",
    "contractProcessingScript": "D:\\FutureFixture\\Scripts\\contracts.py",
    "knowledgeIngestionScript": "D:\\FutureFixture\\Scripts\\knowledge.py"
  },
  "folders": {
    "invoiceInputFolder": "D:\\FutureFixture\\Invoices\\Input",
    "invoiceOutputFolder": "D:\\FutureFixture\\Invoices\\Output",
    "invoiceArchiveFolder": "D:\\FutureFixture\\Invoices\\Archive",
    "invoiceLogFolder": "D:\\FutureFixture\\Invoices\\Logs",
    "scansioniNetworkShare": "\\\\FUTURE-FIXTURE\\Shared\\Scansioni",
